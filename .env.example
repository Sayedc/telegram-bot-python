# ---- Required --------------------------------------------------------------
# Token from @BotFather (the code reads BOT_TOKEN, NOT TELEGRAM_BOT_TOKEN)
BOT_TOKEN=your_bot_token_here
# Telegram user IDs of the admins, comma separated
ADMIN_IDS=123456789

# ---- Optional ----------------------------------------------------------------
# Keep users across deploys: point this at a mounted volume
# DATABASE_PATH=/data/database.json

# Cookies: paste the FULL content of a Netscape cookies.txt (never commit them)
# YOUTUBE_COOKIES=
# INSTAGRAM_COOKIES=
# FACEBOOK_COOKIES=
# TIKTOK_COOKIES=

# Proxy for blocked server IPs (e.g. http://user:pass@host:port)
# PROXY=

# Seconds before a single download is given up (default 900)
# DOWNLOAD_TIMEOUT=900

# Search by name: longest pickable result in minutes (default 90) and search timeout in seconds (default 30)
# MAX_DURATION_MINUTES=90
# SEARCH_TIMEOUT=30

# Debug only: force specific YouTube player clients, comma separated
# YT_PLAYER_CLIENTS=
